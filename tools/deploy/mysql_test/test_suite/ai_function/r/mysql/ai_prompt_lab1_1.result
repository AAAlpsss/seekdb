select json_unquote(json_extract(ai_prompt('{1}/{0}/{1}', 'a', 'b'), '$.template')) = '{1}/{0}/{1}' as ok;
ok
1
select json_length(ai_prompt('{0}/{9}', 'a'), '$.args') = 1 as ok;
ok
