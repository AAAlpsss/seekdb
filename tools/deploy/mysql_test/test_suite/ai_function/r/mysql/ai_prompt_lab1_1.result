set @prompt_lab_special = concat('中文😀', char(34), char(92), char(10), char(0), '{0}');
select binary json_unquote(json_extract(ai_prompt(@prompt_lab_special), '$.template')) = binary @prompt_lab_special as ok;
ok
1
select binary json_unquote(json_extract(ai_prompt('{0}', @prompt_lab_special), '$.args[0]')) = binary @prompt_lab_special as ok;
ok
1
create table t_ai_prompt_lab1_1 (id int primary key, tmpl longtext, arg longtext, txt text, tb tinyblob, mb mediumblob, j json);
insert into t_ai_prompt_lab1_1 values (1, concat(repeat('中',70000),'{1}/{0}/{1}'), repeat('😀',70000), repeat('文',10000), 'tiny', repeat('blob',20000), json_object('k',json_array(1,true))), (2,null,null,null,null,null,null);
select binary json_unquote(json_extract(ai_prompt(tmpl, arg), '$.template')) = binary tmpl and binary json_unquote(json_extract(ai_prompt(tmpl, arg), '$.args[0]')) = binary arg as ok from t_ai_prompt_lab1_1 where id = 1;
ok
1
select binary json_unquote(json_extract(ai_prompt(txt, txt), '$.template')) = binary txt and binary json_unquote(json_extract(ai_prompt(txt, txt), '$.args[0]')) = binary txt as ok from t_ai_prompt_lab1_1 where id = 1;
ok
1
select json_unquote(json_extract(ai_prompt(tb, tb), '$.template')) = 'tiny' and json_unquote(json_extract(ai_prompt(tb, tb), '$.args[0]')) = 'tiny' as ok from t_ai_prompt_lab1_1 where id = 1;
ok
1
select binary json_unquote(json_extract(ai_prompt(mb, mb), '$.template')) = binary mb and binary json_unquote(json_extract(ai_prompt(mb, mb), '$.args[0]')) = binary mb as ok from t_ai_prompt_lab1_1 where id = 1;
ok
1
select json_extract(ai_prompt('{0}', j), '$.args[0]') = j as ok from t_ai_prompt_lab1_1 where id = 1;
ok
